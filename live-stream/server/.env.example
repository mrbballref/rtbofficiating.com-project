# Required
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:4242
PORT=4242

# Create recurring Stripe Prices for each paid membership and paste the Price IDs here.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_ALL_ACCESS_MONTHLY=
STRIPE_PRICE_ALL_ACCESS_ANNUAL=

# Optional: set after configuring a Stripe Customer Portal configuration.
STRIPE_CUSTOMER_PORTAL_CONFIGURATION=

# Membership persistence. Never expose the service-role key to browser JavaScript.
# Find the service-role key at https://supabase.com/dashboard/project/xnwcgbnasvhkuiejtxer/settings/api-keys
SUPABASE_URL=https://xnwcgbnasvhkuiejtxer.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
