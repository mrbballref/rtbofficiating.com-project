PORT=4173
PUBLIC_BASE_URL=http://localhost:4173
PAYMENTS_ENVIRONMENT=sandbox

# Stripe test/sandbox credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal sandbox credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Safety guard: current browser-local catalog is not an authoritative server catalog.
# Keep production client pricing disabled. Sandbox can be enabled for test transactions.
ALLOW_CLIENT_PRICING_IN_SANDBOX=true
ALLOW_CLIENT_PRICING_IN_PRODUCTION=false

# Order persistence. Never expose the service-role key to browser JavaScript.
# Find the service-role key at https://supabase.com/dashboard/project/xnwcgbnasvhkuiejtxer/settings/api-keys
SUPABASE_URL=https://xnwcgbnasvhkuiejtxer.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
